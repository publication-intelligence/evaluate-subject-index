{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-result-v11.schema.json",
  "title": "V8 scored subject-index evaluation result",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "candidate", "provenance", "audit_scope", "dimension_calculations", "scorecard", "overall_percentage", "interpretation", "metrics", "item_assessments", "structure_locator_review", "projection_metadata", "critical_gates", "defect_counts", "comparison_key", "limitations"],
  "properties": {
    "schema_version": {"const": "subject-index-evaluation-result-v11"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate": {"$ref": "evaluation-result-v6.schema.json#/properties/candidate"},
    "provenance": {
      "type": "object",
      "required": ["source_sha256", "judgment_policy_sha256", "benchmark_sha256", "rubric_version", "dimension_calculation_profile"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "judgment_policy_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v8"},
        "dimension_calculation_profile": {"const": "subject-index-dimension-calculation-v5"}
      },
      "additionalProperties": true
    },
    "audit_scope": {"$ref": "evaluation-result-v6.schema.json#/properties/audit_scope"},
    "dimension_calculations": {"allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["calculation_profile"], "properties": {"schema_version": {"const": "subject-index-dimension-calculations-v6"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v5"}}}]},
    "scorecard": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "required": ["dimension_id", "weight", "dimension_percentage", "weighted_contribution", "formula_id"], "properties": {"dimension_id": {"type": "string"}, "weight": {"type": "number"}, "dimension_percentage": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}, "weighted_contribution": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}, "formula_id": {"type": "string", "pattern": "^subject-index-dimension-calculation-v5:"}}, "additionalProperties": true}},
    "overall_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "interpretation": {"type": "string"},
    "metrics": {"type": "object", "required": ["keep_precision"], "properties": {"keep_precision": {"type": "object"}}, "additionalProperties": true},
    "item_assessments": {"allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["grading_policy", "summary"], "properties": {"schema_version": {"const": "subject-index-item-assessments-v6"}, "grading_policy": {"const": "subject-index-item-grading-v4"}, "summary": {"type": "object"}}}]},
    "structure_locator_review": {"allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["review_sha256", "summary"], "properties": {"schema_version": {"const": "subject-index-structure-locator-review-v1"}, "review_sha256": {"$ref": "#/$defs/sha256"}, "summary": {"type": "object"}}}]},
    "projection_metadata": {"allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["projection_metadata_sha256"], "properties": {"schema_version": {"const": "subject-index-v8-projection-metadata-v1"}, "projection_metadata_sha256": {"$ref": "#/$defs/sha256"}}}]},
    "locator_fit_compatibility": {"description": "Projected score-free compatibility and unresolved-fit provenance, including any conflict routed under F-COMPAT-LEGACY-FIT-CONFLICT-TO-SUPPLEMENT-V1.", "$ref": "dimension-calculations-v6.schema.json#/properties/locator_fit_compatibility"},
    "locator_fit_supplement": {"$ref": "v8-projection-metadata-v1.schema.json#/$defs/fitSupplementReference"},
    "critical_gates": {"type": "array", "items": {"type": "object"}},
    "defect_counts": {"type": "object"},
    "comparison_key": {
      "type": "object",
      "required": ["source_sha256", "benchmark_sha256", "judgment_policy_sha256", "page_map_sha256", "chunk_manifest_sha256", "inclusion_policy", "audit_mode", "uncertainty_policy", "rubric_version", "dimension_calculation_profile"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "judgment_policy_sha256": {"$ref": "#/$defs/sha256"},
        "page_map_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "inclusion_policy": {"type": "string"},
        "audit_mode": {"enum": ["full", "pilot"]},
        "uncertainty_policy": {"type": "string"},
        "rubric_version": {"const": "subject-index-rubric-v8"},
        "dimension_calculation_profile": {"const": "subject-index-dimension-calculation-v5"}
      },
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256"],
      "properties": {
        "schema_version": {"type": "string"},
        "artifact_path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"}
  },
  "additionalProperties": false
}
