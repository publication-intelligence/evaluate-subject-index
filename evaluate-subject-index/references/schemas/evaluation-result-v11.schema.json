{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-result-v11.schema.json",
  "title": "V8 scored result with heading-access causal provenance",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "candidate", "provenance", "audit_scope", "dimension_calculations", "scorecard", "total_score", "interpretation", "metrics", "item_assessments", "heading_access_causal_provenance", "structure_audit", "projection_metadata", "critical_gates", "defect_counts", "comparison_key", "limitations"],
  "properties": {
    "schema_version": {"const": "subject-index-evaluation-result-v11"},
    "evaluation_id": {"$ref": "evaluation-result-v10.schema.json#/properties/evaluation_id"},
    "candidate": {"$ref": "evaluation-result-v10.schema.json#/properties/candidate"},
    "provenance": {"$ref": "evaluation-result-v10.schema.json#/properties/provenance"},
    "audit_scope": {"$ref": "evaluation-result-v10.schema.json#/properties/audit_scope"},
    "dimension_calculations": {"$ref": "evaluation-result-v10.schema.json#/properties/dimension_calculations"},
    "scorecard": {"$ref": "evaluation-result-v10.schema.json#/properties/scorecard"},
    "total_score": {"$ref": "evaluation-result-v10.schema.json#/properties/total_score"},
    "interpretation": {"$ref": "evaluation-result-v10.schema.json#/properties/interpretation"},
    "metrics": {"$ref": "evaluation-result-v10.schema.json#/properties/metrics"},
    "item_assessments": {
      "allOf": [
        {"$ref": "evaluation-result-v10.schema.json#/$defs/artifact"},
        {"required": ["grading_policy", "summary"], "properties": {"schema_version": {"const": "subject-index-item-assessments-v7"}, "grading_policy": {"const": "subject-index-item-grading-v4"}, "summary": {"type": "object"}}}
      ]
    },
    "heading_access_causal_provenance": {"$ref": "item-assessments-v7.schema.json#/properties/heading_access_causal_provenance"},
    "structure_audit": {
      "allOf": [
        {"$ref": "evaluation-result-v10.schema.json#/$defs/artifact"},
        {"properties": {"schema_version": {"const": "structure-audit-v6"}}}
      ]
    },
    "projection_metadata": {
      "allOf": [
        {"$ref": "evaluation-result-v10.schema.json#/$defs/artifact"},
        {"required": ["projection_metadata_sha256"], "properties": {"schema_version": {"const": "subject-index-v8-projection-metadata-v2"}, "projection_metadata_sha256": {"$ref": "evaluation-result-v10.schema.json#/$defs/sha256"}}}
      ]
    },
    "critical_gates": {"$ref": "evaluation-result-v10.schema.json#/properties/critical_gates"},
    "defect_counts": {"$ref": "evaluation-result-v10.schema.json#/properties/defect_counts"},
    "comparison_key": {"$ref": "evaluation-result-v10.schema.json#/properties/comparison_key"},
    "limitations": {"$ref": "evaluation-result-v10.schema.json#/properties/limitations"}
  },
  "additionalProperties": false
}
