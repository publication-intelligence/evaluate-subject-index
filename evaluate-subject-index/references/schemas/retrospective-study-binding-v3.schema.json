{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrospective-study-binding-v3.schema.json",
  "type": "object",
  "required": [
    "candidate_seen",
    "migrated_at",
    "semantic_change",
    "policy_semantic_change",
    "audit_transfer_authorized",
    "historical_freeze",
    "prior_state",
    "lock",
    "release_benchmark",
    "approval",
    "release_review",
    "release_policy",
    "methodology_migration"
  ],
  "properties": {
    "candidate_seen": {
      "const": true
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time"
    },
    "semantic_change": {
      "type": "boolean"
    },
    "policy_semantic_change": {
      "type": "boolean"
    },
    "audit_transfer_authorized": {
      "const": false
    },
    "historical_freeze": {
      "type": "object"
    },
    "prior_state": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
