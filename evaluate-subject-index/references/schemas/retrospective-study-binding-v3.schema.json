    "methodology_migration": {
      "const": {
        "source_rubric": "subject-index-rubric-v8.2",
        "target_rubric": "subject-index-rubric-v10",
        "source_proof_rewritten": false,
        "scoring_semantics_changed": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "percentageOnly": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "pattern": "(^rating$|^rating_delta$|^maximum_rating$|_rating$)"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/percentageOnly"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/percentageOnly"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/percentageOnly"
    }
  ]
