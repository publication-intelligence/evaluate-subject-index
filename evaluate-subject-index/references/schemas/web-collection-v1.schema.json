{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-collection-v1.schema.json",
  "title": "V8 public web collection",
  "type": "object",
  "required": ["schema_version", "collection_kind", "source_order", "count", "items", "collection_sha256"],
  "properties": {
    "schema_version": {"const": "ohfr-v8-web-collection-v1"},
    "collection_kind": {"enum": ["index_records", "source_subjects", "density"]},
    "source_order": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "items": {"type": "array"},
    "collection_sha256": {"$ref": "#/$defs/hash"}
  },
  "additionalProperties": true,
  "allOf": [{
    "if": {"properties": {"collection_kind": {"const": "density"}}, "required": ["collection_kind"]},
    "then": {
      "required": ["fit_percentage"],
      "properties": {"fit_percentage": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}},
      "not": {"required": ["fit_rating"]}
    }
  }],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
