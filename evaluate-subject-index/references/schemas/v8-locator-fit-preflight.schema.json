{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v8-locator-fit-preflight.schema.json",
  "title": "Native V8 locator-fit preflight",
  "type": "object",
  "required": ["schema_version", "validated_complete_path_fit", "invalid_or_contradictory_state", "group_counts", "aggregate_v8_score_available", "prose_inference_used"],
  "properties": {
    "schema_version": {"const": "subject-index-v8-locator-fit-preflight-v1"},
    "validated_complete_path_fit": {"type": "array", "items": {"$ref": "#/$defs/validatedFit"}},
    "invalid_or_contradictory_state": {"type": "array", "items": {"type": "object"}},
    "group_counts": {
      "type": "object",
      "required": ["validated_complete_path_fit", "invalid_or_contradictory_state"],
      "properties": {
        "validated_complete_path_fit": {"type": "integer", "minimum": 0},
        "invalid_or_contradictory_state": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "aggregate_v8_score_available": {"const": false},
    "prose_inference_used": {"const": false}
  },
  "$defs": {
    "validatedFit": {
      "type": "object",
      "required": ["locator_id", "path_id", "fit_category", "fit_classification_source", "prose_inference_used"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-"},
        "path_id": {"type": "string", "pattern": "^PATH-"},
        "fit_category": {"enum": ["exact_fit", "material_partial_fit", "material_mismatch", "severe_mismatch", "no_fit", "uninspectable"]},
        "fit_classification_source": {"const": "native_complete_path_fit"},
        "prose_inference_used": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
