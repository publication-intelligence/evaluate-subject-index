{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missing-access-audit-v2.schema.json",
  "title": "Semantic missing access audit batch",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "benchmark_sha256",
    "candidate_sha256",
    "chunk_id",
    "expected_subject_ids",
    "expected_reader_task_ids",
    "expected_treatment_ids",
    "subject_judgments",
    "reader_task_results",
    "treatment_judgments",
    "reader_task_completion",
    "treatment_completion",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": "missing-access-audit-v2"
    },
    "evaluation_id": {
      "type": "string"
    },
    "benchmark_sha256": {
      "type": "string"
    },
    "candidate_sha256": {
      "type": "string"
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^CHUNK-"
    },
    "expected_subject_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_reader_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-"
      },
      "uniqueItems": true
    },
    "expected_treatment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TREAT-"
      },
      "uniqueItems": true
    },
    "missing_access_ownership_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "subject_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_id",
          "priority",
          "coverage",
          "direct_access",
          "cross_reference_access",
          "stance_preserved",
          "matched_path_ids",
          "expected_document_pages",
          "found_document_pages",
          "missed_document_pages",
          "severity",
          "confidence",
          "realistic_first_lookup_success",
          "treatment_recall",
          "locator_recall",
          "missing_routes",
          "missed_treatments",
          "error_codes",
          "evidence_ids",
          "uncertainty",
          "axis_resolution",
          "semantic_uncertainties"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^SUBJ-"
          },
          "priority": {
            "enum": [
              "essential",
              "major",
              "optional"
            ]
          },
          "coverage": {
            "oneOf": [
              {
                "enum": [
                  "complete",
                  "partial",
                  "missing",
                  "uninspectable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "direct_access": {
            "type": "boolean"
          },
          "cross_reference_access": {
            "type": "boolean"
          },
          "stance_preserved": {
            "oneOf": [
              {
                "enum": [
                  "yes",
                  "partly",
                  "no",
                  "not_applicable",
                  "uninspectable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "matched_path_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PATH-"
            },
            "uniqueItems": true
          },
          "expected_document_pages": {
            "$ref": "#/$defs/pageSet"
          },
          "found_document_pages": {
            "$ref": "#/$defs/pageSet"
          },
          "missed_document_pages": {
            "$ref": "#/$defs/pageSet"
          },
          "severity": {
            "enum": [
              "none",
              "minor",
              "major",
              "critical"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "realistic_first_lookup_success": {
            "oneOf": [
              {
                "enum": [
                  "yes",
                  "partly",
                  "no",
                  "uninspectable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "treatment_recall": {
            "$ref": "#/$defs/treatmentRecall"
          },
          "locator_recall": {
            "$ref": "#/$defs/recallCounts"
          },
          "missing_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "route_type",
                "reason_code",
                "evidence_ids"
              ],
              "properties": {
                "route_type": {
                  "enum": [
                    "direct",
                    "cross_reference"
                  ]
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "$ref": "#/$defs/evidenceIds"
                }
              },
              "additionalProperties": true
            }
          },
          "missed_treatments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_page",
                "locator_class",
                "reason_code",
                "evidence_ids"
              ],
              "properties": {
                "document_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "locator_class": {
                  "enum": [
                    "principal",
                    "supporting",
                    "synthesis_or_conclusion"
                  ]
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "$ref": "#/$defs/evidenceIds"
                }
              },
              "additionalProperties": true
            }
          },
          "error_codes": {
            "type": "array",
            "items": {
              "enum": [
                "SCP",
                "COV",
                "SEL",
                "CON",
                "STA",
                "LOC_POS",
                "LOC_NEG",
                "CMP",
                "HED",
                "SUB",
                "XRF",
                "DEN",
                "MEC"
              ]
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidenceIds"
          },
          "uncertainty": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "none",
                  "uncertain",
                  "uninspectable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence_ids": {
                "$ref": "#/$defs/evidenceIds"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "uncertain",
                        "uninspectable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason",
                    "evidence_ids"
                  ]
                }
              }
            ],
            "additionalProperties": true
          },
          "dependency_defects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dependencyDefect"
            }
          },
          "axis_resolution": {
            "type": "object",
            "required": [
              "coverage",
              "stance_preserved",
              "realistic_first_lookup_success"
            ],
            "properties": {
              "coverage": {
                "enum": [
                  "known",
                  "unresolved"
                ]
              },
              "stance_preserved": {
                "enum": [
                  "known",
                  "unresolved"
                ]
              },
              "realistic_first_lookup_success": {
                "enum": [
                  "known",
                  "unresolved"
                ]
              }
            },
            "additionalProperties": false
          },
          "semantic_uncertainties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "reason_category",
                "rationale",
                "evidence_ids"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason_category": {
                  "enum": [
                    "unresolved_referent",
                    "unresolved_relationship",
                    "unresolved_scope",
                    "dependent_semantic_uncertainty"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "$ref": "#/$defs/evidenceIds"
                },
                "locator_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^LOC-"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "reader_task_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "subject_ids",
          "result",
          "access_mode",
          "matched_path_ids",
          "severity",
          "confidence",
          "evidence_ids",
          "axis_resolution",
          "semantic_uncertainties"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-"
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SUBJ-"
            },
            "uniqueItems": true
          },
          "result": {
            "oneOf": [
              {
                "enum": [
                  "succeeds",
                  "partially_succeeds",
                  "fails",
                  "uninspectable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "access_mode": {
            "enum": [
              "direct",
              "cross_reference",
              "mixed",
              "none",
              "uninspectable"
            ]
          },
          "matched_path_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PATH-"
            },
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "none",
              "cosmetic",
              "minor",
              "major",
              "critical"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidenceIds"
          },
          "axis_resolution": {
            "type": "object",
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "enum": [
                  "known",
                  "unresolved"
                ]
              }
            },
            "additionalProperties": false
          },
          "semantic_uncertainties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "reason_category",
                "rationale",
                "evidence_ids"
              ],
              "properties": {
                "field": {
                  "const": "result"
                },
                "reason_category": {
                  "enum": [
                    "unresolved_referent",
                    "unresolved_relationship",
                    "unresolved_scope",
                    "dependent_semantic_uncertainty"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "$ref": "#/$defs/evidenceIds"
                },
                "locator_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^LOC-"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "treatment_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "treatment_id",
          "subject_id",
          "document_page",
          "locator_class",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "treatment_id": {
            "type": "string",
            "pattern": "^TREAT-"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^SUBJ-"
          },
          "document_page": {
            "type": "integer",
            "minimum": 1
          },
          "locator_class": {
            "enum": [
              "principal",
              "supporting",
              "synthesis_or_conclusion"
            ]
          },
          "status": {
            "enum": [
              "found",
              "missed",
              "uninspectable"
            ]
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidenceIds"
          }
        },
        "additionalProperties": true
      }
    },
    "reader_task_completion": {
      "$ref": "#/$defs/exactCompletion"
    },
    "treatment_completion": {
      "$ref": "#/$defs/exactCompletion"
    },
    "dependency_defects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyDefect"
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "expected",
        "judged",
        "complete"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "subjects_unique": {
          "type": "boolean"
        },
        "reader_tasks_expected": {
          "type": "integer",
          "minimum": 0
        },
        "reader_tasks_judged": {
          "type": "integer",
          "minimum": 0
        },
        "reader_tasks_unique": {
          "type": "boolean"
        },
        "concept_coverage_counts": {
          "$ref": "#/$defs/coverageCounts"
        },
        "locator_recall": {
          "$ref": "#/$defs/recallCounts"
        },
        "semantic_unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EVID-"
      },
      "uniqueItems": true
    },
    "pageSet": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "dependencyDefect": {
      "type": "object",
      "required": [
        "defect_id",
        "dependency_type",
        "disposition",
        "locator_id",
        "coverage_subject_ids",
        "observed_conflict",
        "confidence",
        "required_adjudication",
        "evidence_ids"
      ],
      "properties": {
        "defect_id": {
          "type": "string",
          "pattern": "^DEFECT-"
        },
        "dependency_type": {
          "const": "locator_audit"
        },
        "disposition": {
          "const": "reported_without_reinterpretation"
        },
        "locator_id": {
          "type": "string",
          "pattern": "^LOC-"
        },
        "coverage_subject_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SUBJ-"
          },
          "uniqueItems": true
        },
        "observed_conflict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "required_adjudication": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "summary": {
          "type": "string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      },
      "additionalProperties": true
    },
    "recallCounts": {
      "type": "object",
      "required": [
        "expected",
        "found",
        "missed"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "found": {
          "type": "integer",
          "minimum": 0
        },
        "missed": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "treatmentClassPages": {
      "type": "object",
      "required": [
        "expected_document_pages",
        "found_document_pages",
        "missed_document_pages",
        "uninspectable_document_pages"
      ],
      "properties": {
        "expected_document_pages": {
          "$ref": "#/$defs/pageSet"
        },
        "found_document_pages": {
          "$ref": "#/$defs/pageSet"
        },
        "missed_document_pages": {
          "$ref": "#/$defs/pageSet"
        },
        "uninspectable_document_pages": {
          "$ref": "#/$defs/pageSet"
        }
      },
      "additionalProperties": false
    },
    "treatmentRecall": {
      "type": "object",
      "required": [
        "principal",
        "supporting",
        "synthesis_or_conclusion"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/treatmentClassPages"
        },
        "supporting": {
          "$ref": "#/$defs/treatmentClassPages"
        },
        "synthesis_or_conclusion": {
          "$ref": "#/$defs/treatmentClassPages"
        }
      },
      "additionalProperties": false
    },
    "coverageCounts": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "uninspectable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "exactCompletion": {
      "type": "object",
      "required": [
        "expected",
        "judged",
        "complete"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "unique": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "semantic_unresolved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
