{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-report-v10.schema.json",
  "title": "Display-ready V8 report with heading-access causal provenance",
  "type": "object",
  "required": ["schema_version", "report_id", "headline", "summary", "grade", "scorecard", "calculation_explainer", "precision_diagnostics", "structure_audit", "key_metrics", "density", "gate_status", "strengths", "defects", "examples", "item_grade_index", "locator_explanations", "heading_access_causal_provenance", "score_views", "methodology", "comparability", "disclosures", "limitations", "evidence_index"],
  "properties": {
    "schema_version": {"const": "subject-index-web-report-v10"},
    "report_id": {"$ref": "web-report-v8.schema.json#/properties/report_id"},
    "headline": {"$ref": "web-report-v8.schema.json#/properties/headline"},
    "summary": {"$ref": "web-report-v8.schema.json#/properties/summary"},
    "grade": {"$ref": "web-report-v8.schema.json#/properties/grade"},
    "scorecard": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "required": ["dimension_id", "dimension_percentage", "weight", "weighted_contribution", "formula_id"], "properties": {"dimension_id": {"type": "string"}, "dimension_percentage": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "weight": {"type": "number"}, "weighted_contribution": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "formula_id": {"type": "string", "pattern": "^subject-index-dimension-calculation-v5:"}}, "additionalProperties": false}},
    "calculation_explainer": {"allOf": [{"$ref": "#/$defs/calculationReference"}, {"required": ["item_grades_used", "gates_used"], "properties": {"item_grades_used": {"const": false}, "gates_used": {"const": false}}}]},
    "precision_diagnostics": {"$ref": "web-report-v8.schema.json#/properties/precision_diagnostics"},
    "structure_audit": {
      "allOf": [
        {
          "type": "object",
          "required": ["schema_version", "artifact_path", "sha256"],
          "properties": {
            "schema_version": {"const": "structure-audit-v6"},
            "artifact_path": {"$ref": "web-report-v8.schema.json#/$defs/portablePath"},
            "sha256": {"$ref": "web-report-v8.schema.json#/$defs/sha256"}
          },
          "additionalProperties": true
        },
        {
          "required": ["candidate_denominator", "full_scope_attestation", "locator_architecture", "uncertainties"],
          "properties": {
            "candidate_denominator": {"$ref": "structure-audit-v5.schema.json#/properties/candidate_denominator"},
            "full_scope_attestation": {"$ref": "structure-audit-v5.schema.json#/properties/full_scope_attestation"},
            "locator_architecture": {"$ref": "structure-audit-v5.schema.json#/properties/locator_architecture"},
            "uncertainties": {"$ref": "structure-audit-v5.schema.json#/properties/uncertainties"}
          }
        }
      ]
    },
    "key_metrics": {"$ref": "web-report-v8.schema.json#/properties/key_metrics"},
    "density": {"$ref": "web-report-v8.schema.json#/properties/density"},
    "gate_status": {"$ref": "web-report-v8.schema.json#/properties/gate_status"},
    "strengths": {"$ref": "web-report-v8.schema.json#/properties/strengths"},
    "defects": {"$ref": "web-report-v8.schema.json#/properties/defects"},
    "examples": {"$ref": "web-report-v8.schema.json#/properties/examples"},
    "item_grade_index": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "grading_policy", "summary", "color_legend", "interaction"],
      "properties": {
        "schema_version": {"const": "subject-index-item-assessments-v7"},
        "artifact_path": {"$ref": "web-report-v8.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "web-report-v8.schema.json#/$defs/sha256"},
        "grading_policy": {"const": "subject-index-item-grading-v4"},
        "summary": {"type": "object"},
        "color_legend": {"type": "array"},
        "interaction": {"type": "object"}
      },
      "additionalProperties": false
    },
    "locator_explanations": {"type": "array", "items": {"$ref": "item-assessments-v7.schema.json#/$defs/locatorExplanation"}},
    "heading_access_causal_provenance": {"$ref": "item-assessments-v7.schema.json#/properties/heading_access_causal_provenance"},
    "score_views": {
      "type": "object",
      "required": ["primary_view_id", "adjustment_status", "views"],
      "properties": {
        "primary_view_id": {"const": "canonical_as_delivered"},
        "adjustment_status": {"enum": ["none", "separate_evidentiary_correction"]},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["view_id", "label", "view_kind", "score", "maximum", "calculation", "structure_audit", "causal_attribution", "provenance_artifacts"],
            "properties": {
              "view_id": {"type": "string"},
              "label": {"type": "string"},
              "view_kind": {"enum": ["observed", "counterfactual"]},
              "score": {"type": ["number", "null"]},
              "maximum": {"const": 100},
              "calculation": {"$ref": "#/$defs/calculationReference"},
              "structure_audit": {"$ref": "#/properties/structure_audit/allOf/0"},
              "causal_attribution": {"enum": ["primary_observed_result", "separate_evidentiary_correction_not_methodology_effect"]},
              "provenance_artifacts": {"type": "array", "items": {"$ref": "web-report-v8.schema.json#/$defs/provenanceArtifact"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "methodology": {"type": "object", "required": ["rubric_version", "calculation_profile", "locator_utility", "diagnostic_minimum_rule", "binary_keep_rule", "keep_precision", "editorial_selectivity_separate", "long_string_review", "long_range_review", "numeric_trigger_is_automatic_defect"], "properties": {"rubric_version": {"const": "subject-index-rubric-v8"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v5"}, "locator_utility": {"type": "string"}, "diagnostic_minimum_rule": {"type": "string"}, "binary_keep_rule": {"type": "string"}, "keep_precision": {"type": "string"}, "editorial_selectivity_separate": {"const": true}, "long_string_review": {"type": "string"}, "long_range_review": {"type": "string"}, "numeric_trigger_is_automatic_defect": {"const": false}}, "additionalProperties": false},
    "comparability": {"$ref": "web-report-v8.schema.json#/properties/comparability"},
    "disclosures": {"$ref": "web-report-v8.schema.json#/properties/disclosures"},
    "limitations": {"$ref": "web-report-v8.schema.json#/properties/limitations"},
    "evidence_index": {"$ref": "web-report-v8.schema.json#/properties/evidence_index"}
  },
  "$defs": {
    "calculationReference": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "calculation_sha256", "rubric_version", "calculation_profile"],
      "properties": {
        "schema_version": {"const": "subject-index-dimension-calculations-v6"},
        "artifact_path": {"$ref": "web-report-v8.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "web-report-v8.schema.json#/$defs/sha256"},
        "calculation_sha256": {"$ref": "web-report-v8.schema.json#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v8"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v5"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
