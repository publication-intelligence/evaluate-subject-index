{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-audit-v6.schema.json",
  "title": "Native V8 structure audit with heading-access causal provenance",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "candidate_sha256", "audit_mode", "candidate_denominator", "full_scope_attestation", "metrics", "density", "node_judgments", "cross_reference_judgments", "locator_architecture", "defects", "strengths", "uncertainties", "scoring_context"],
  "properties": {
    "schema_version": {"const": "structure-audit-v6"},
    "evaluation_id": {"$ref": "structure-audit-v5.schema.json#/properties/evaluation_id"},
    "candidate_sha256": {"$ref": "structure-audit-v5.schema.json#/properties/candidate_sha256"},
    "audit_mode": {"$ref": "structure-audit-v5.schema.json#/properties/audit_mode"},
    "candidate_denominator": {"$ref": "structure-audit-v5.schema.json#/properties/candidate_denominator"},
    "full_scope_attestation": {"$ref": "structure-audit-v5.schema.json#/properties/full_scope_attestation"},
    "metrics": {"$ref": "structure-audit-v5.schema.json#/properties/metrics"},
    "density": {"$ref": "structure-audit-v5.schema.json#/properties/density"},
    "node_judgments": {"type": "array", "items": {"$ref": "#/$defs/nodeException"}},
    "cross_reference_judgments": {"$ref": "structure-audit-v5.schema.json#/properties/cross_reference_judgments"},
    "locator_architecture": {"$ref": "structure-audit-v5.schema.json#/properties/locator_architecture"},
    "defects": {"$ref": "structure-audit-v5.schema.json#/properties/defects"},
    "strengths": {"$ref": "structure-audit-v5.schema.json#/properties/strengths"},
    "uncertainties": {"$ref": "structure-audit-v5.schema.json#/properties/uncertainties"},
    "scoring_context": {"$ref": "structure-audit-v5.schema.json#/properties/scoring_context"},
    "causal_projection": {
      "type": "object",
      "required": ["source_schema_version", "source_structure_audit_file_sha256", "projection_input_file_sha256", "scores_recomputed", "source_artifact_mutated", "scoring_fields_changed"],
      "properties": {
        "source_schema_version": {"const": "structure-audit-v5"},
        "source_structure_audit_file_sha256": {"$ref": "structure-audit-v5.schema.json#/$defs/sha256"},
        "projection_input_file_sha256": {"$ref": "structure-audit-v5.schema.json#/$defs/sha256"},
        "scores_recomputed": {"const": false},
        "source_artifact_mutated": {"const": false},
        "scoring_fields_changed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "causalFinding": {
      "type": "object",
      "required": ["finding_id", "kind", "source_ids", "reason_codes", "severity", "evidence_ids", "summary"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^HAF-"},
        "kind": {"enum": ["heading_fit", "benchmark_access", "cross_reference", "confirmed_subdivision_architecture"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:LOC|PATH|SUBJ|TASK|TREAT|XREF|NODE|DEFECT|ARCHREV)-"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "severity": {"enum": ["minor", "major", "critical"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVID-"}, "uniqueItems": true},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "primaryBasis": {
      "type": "object",
      "required": ["basis", "basis_id"],
      "properties": {"basis": {"enum": ["deterministic_rule", "explicit_adjudication"]}, "basis_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "headingAccessComponent": {
      "type": "object",
      "required": ["status", "summary", "evidence_ids", "causal_findings"],
      "properties": {
        "status": {"enum": ["passes", "minor_issues", "major_issues", "fails", "uninspectable", "not_applicable", "not_measured"]},
        "summary": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "causal_findings": {"type": "array", "items": {"$ref": "#/$defs/causalFinding"}},
        "primary_finding_id": {"type": "string", "pattern": "^HAF-"},
        "primary_basis": {"$ref": "#/$defs/primaryBasis"}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["minor_issues", "major_issues", "fails"]}}, "required": ["status"]}, "then": {"properties": {"causal_findings": {"minItems": 1}}}}],
      "dependentRequired": {"primary_finding_id": ["primary_basis"], "primary_basis": ["primary_finding_id"]},
      "additionalProperties": false
    },
    "nodeException": {
      "type": "object",
      "required": ["node_id", "component_judgments", "summary", "confidence", "evidence_ids"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^NODE-"},
        "component_judgments": {"type": "object", "required": ["conceptual_stance_fidelity", "heading_access_architecture", "mechanics_consistency"], "properties": {
          "conceptual_stance_fidelity": {"$ref": "structure-audit-v5.schema.json#/$defs/standardComponent"},
          "heading_access_architecture": {"$ref": "#/$defs/headingAccessComponent"},
          "mechanics_consistency": {"$ref": "structure-audit-v5.schema.json#/$defs/mechanicsComponent"}
        }, "additionalProperties": false},
        "summary": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
