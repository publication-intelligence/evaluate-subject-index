{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-audit-v6.schema.json",
  "title": "V8 global structure audit with heading-access causal provenance",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "candidate_sha256", "item_inventory_sha256", "audit_mode", "scope_complete", "metrics", "density", "expected_node_ids", "node_judgments", "expected_cross_reference_ids", "cross_reference_judgments", "defects", "strengths", "completion", "provenance", "v5_scoring_context", "v7_architecture_review_decisions"],
  "properties": {
    "schema_version": {"const": "structure-audit-v6"},
    "evaluation_id": {"$ref": "structure-audit-v5.schema.json#/properties/evaluation_id"},
    "candidate_sha256": {"$ref": "structure-audit-v5.schema.json#/properties/candidate_sha256"},
    "item_inventory_sha256": {"$ref": "structure-audit-v5.schema.json#/properties/item_inventory_sha256"},
    "audit_mode": {"$ref": "structure-audit-v5.schema.json#/properties/audit_mode"},
    "scope_complete": {"$ref": "structure-audit-v5.schema.json#/properties/scope_complete"},
    "metrics": {"$ref": "structure-audit-v5.schema.json#/properties/metrics"},
    "density": {"$ref": "structure-audit-v5.schema.json#/properties/density"},
    "expected_node_ids": {"$ref": "structure-audit-v5.schema.json#/properties/expected_node_ids"},
    "node_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "heading_path", "role", "component_judgments", "summary", "confidence", "evidence_ids"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^NODE-"},
          "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "role": {"enum": ["main_heading", "subheading"]},
          "component_judgments": {
            "type": "object",
            "required": ["conceptual_stance_fidelity", "heading_access_architecture", "mechanics_consistency"],
            "properties": {
              "conceptual_stance_fidelity": {"$ref": "structure-audit-v4.schema.json#/$defs/standardComponent"},
              "heading_access_architecture": {"$ref": "#/$defs/headingAccessComponent"},
              "mechanics_consistency": {"$ref": "structure-audit-v4.schema.json#/$defs/mechanicsComponent"}
            },
            "additionalProperties": false
          },
          "summary": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "expected_cross_reference_ids": {"$ref": "structure-audit-v5.schema.json#/properties/expected_cross_reference_ids"},
    "cross_reference_judgments": {"$ref": "structure-audit-v5.schema.json#/properties/cross_reference_judgments"},
    "defects": {"$ref": "structure-audit-v5.schema.json#/properties/defects"},
    "strengths": {"$ref": "structure-audit-v5.schema.json#/properties/strengths"},
    "completion": {"$ref": "structure-audit-v5.schema.json#/properties/completion"},
    "provenance": {"$ref": "structure-audit-v5.schema.json#/properties/provenance"},
    "v5_scoring_context": {"$ref": "structure-audit-v5.schema.json#/properties/v5_scoring_context"},
    "v7_architecture_review_decisions": {"$ref": "structure-audit-v5.schema.json#/properties/v7_architecture_review_decisions"},
    "causal_projection": {
      "type": "object",
      "required": ["source_schema_version", "source_structure_audit_file_sha256", "projection_input_file_sha256", "scores_recomputed", "source_artifact_mutated", "scoring_fields_changed"],
      "properties": {
        "source_schema_version": {"const": "structure-audit-v5"},
        "source_structure_audit_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "projection_input_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scores_recomputed": {"const": false},
        "source_artifact_mutated": {"const": false},
        "scoring_fields_changed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "causalFinding": {
      "type": "object",
      "required": ["finding_id", "kind", "source_ids", "reason_codes", "severity", "evidence_ids", "summary"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^HAF-"},
        "kind": {"enum": ["heading_fit", "benchmark_access", "cross_reference", "confirmed_subdivision_architecture"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:LOC|PATH|SUBJ|TASK|TREAT|XREF|NODE|DEFECT|ARCHREV)-"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "severity": {"enum": ["minor", "major", "critical"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVID-"}, "uniqueItems": true},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "primaryBasis": {
      "type": "object",
      "required": ["basis", "basis_id"],
      "properties": {
        "basis": {"enum": ["deterministic_rule", "explicit_adjudication"]},
        "basis_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "headingAccessComponent": {
      "type": "object",
      "required": ["status", "summary", "evidence_ids", "causal_findings"],
      "properties": {
        "status": {"enum": ["passes", "minor_issues", "major_issues", "fails", "uninspectable", "not_applicable", "not_measured"]},
        "summary": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "causal_findings": {"type": "array", "items": {"$ref": "#/$defs/causalFinding"}},
        "primary_finding_id": {"type": "string", "pattern": "^HAF-"},
        "primary_basis": {"$ref": "#/$defs/primaryBasis"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["minor_issues", "major_issues", "fails"]}}, "required": ["status"]},
          "then": {"properties": {"causal_findings": {"minItems": 1}}}
        }
      ],
      "dependentRequired": {
        "primary_finding_id": ["primary_basis"],
        "primary_basis": ["primary_finding_id"]
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
