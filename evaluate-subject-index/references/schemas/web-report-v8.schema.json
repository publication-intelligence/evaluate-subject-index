{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-report-v8.schema.json",
  "title": "Display-ready V8 subject-index report",
  "type": "object",
  "required": ["schema_version", "report_id", "headline", "summary", "grade", "scorecard", "calculation_explainer", "precision_diagnostics", "structure_locator_review", "key_metrics", "density", "gate_status", "strengths", "defects", "examples", "item_grade_index", "locator_explanations", "score_views", "methodology", "comparability", "disclosures", "limitations", "evidence_index"],
  "properties": {
    "schema_version": {"const": "subject-index-web-report-v8"},
    "report_id": {"type": "string"},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "grade": {"type": "object", "required": ["score", "maximum", "label"], "properties": {"score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "maximum": {"const": 100}, "label": {"type": "string"}}, "additionalProperties": false},
    "scorecard": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "required": ["dimension_id", "rating", "weight", "awarded_points", "formula_id"], "properties": {"dimension_id": {"type": "string"}, "rating": {"type": ["number", "null"]}, "weight": {"type": "number"}, "awarded_points": {"type": ["number", "null"]}, "formula_id": {"type": "string", "pattern": "^subject-index-dimension-calculation-v4:"}}, "additionalProperties": true}},
    "calculation_explainer": {"allOf": [{"$ref": "#/$defs/calculationReference"}, {"required": ["item_grades_used", "gates_used"], "properties": {"item_grades_used": {"const": false}, "gates_used": {"const": false}}}]},
    "precision_diagnostics": {"type": "object"},
    "structure_locator_review": {"allOf": [{"$ref": "#/$defs/reviewReference"}, {"required": ["thresholds", "summary", "path_reviews"], "properties": {"thresholds": {"type": "object"}, "summary": {"type": "object"}, "path_reviews": {"type": "array"}}}]},
    "key_metrics": {"type": "array", "items": {"type": "object"}},
    "density": {"type": "object"},
    "gate_status": {"type": "object", "required": ["critical_gates", "outcomes_sha256", "used_in_score_arithmetic"], "properties": {"critical_gates": {"type": "array", "items": {"type": "object"}}, "outcomes_sha256": {"$ref": "#/$defs/sha256"}, "used_in_score_arithmetic": {"const": false}}, "additionalProperties": false},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "defects": {"type": "array", "items": {"type": "object"}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "item_grade_index": {"type": "object", "required": ["schema_version", "artifact_path", "sha256", "grading_policy", "summary", "color_legend", "interaction"], "properties": {"schema_version": {"const": "subject-index-item-assessments-v6"}, "artifact_path": {"$ref": "#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "grading_policy": {"const": "subject-index-item-grading-v4"}, "summary": {"type": "object"}, "color_legend": {"type": "array"}, "interaction": {"type": "object"}}, "additionalProperties": false},
    "locator_explanations": {"type": "array", "items": {"$ref": "item-assessments-v6.schema.json#/$defs/locatorExplanation"}},
    "score_views": {"type": "object", "required": ["primary_view_id", "adjustment_status", "views"], "properties": {"primary_view_id": {"const": "canonical_as_delivered"}, "adjustment_status": {"enum": ["none", "separate_evidentiary_correction"]}, "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scoreView"}}}, "additionalProperties": false},
    "locator_fit_compatibility": {"description": "Projected compatibility and unresolved-reason provenance; it is not an aggregate score and gives no historical classifier precedence.", "$ref": "dimension-calculations-v5.schema.json#/properties/locator_fit_compatibility"},
    "locator_fit_supplement": {"$ref": "v8-projection-metadata-v1.schema.json#/$defs/fitSupplementReference"},
    "methodology": {"type": "object", "required": ["rubric_version", "calculation_profile", "locator_utility", "diagnostic_minimum_rule", "binary_keep_rule", "keep_precision", "editorial_selectivity_separate", "long_string_review", "long_range_review", "numeric_trigger_is_automatic_defect"], "properties": {"rubric_version": {"const": "subject-index-rubric-v8"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v4"}, "locator_utility": {"type": "string"}, "diagnostic_minimum_rule": {"type": "string"}, "binary_keep_rule": {"type": "string"}, "keep_precision": {"type": "string"}, "editorial_selectivity_separate": {"const": true}, "long_string_review": {"type": "string"}, "long_range_review": {"type": "string"}, "numeric_trigger_is_automatic_defect": {"const": false}}, "additionalProperties": false},
    "comparability": {"type": "object"},
    "disclosures": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_index": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "calculationReference": {"type": "object", "required": ["schema_version", "artifact_path", "sha256", "calculation_sha256", "rubric_version", "calculation_profile"], "properties": {"schema_version": {"const": "subject-index-dimension-calculations-v5"}, "artifact_path": {"$ref": "#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "calculation_sha256": {"$ref": "#/$defs/sha256"}, "rubric_version": {"const": "subject-index-rubric-v8"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v4"}}, "additionalProperties": true},
    "reviewReference": {"type": "object", "required": ["schema_version", "artifact_path", "sha256", "review_sha256"], "properties": {"schema_version": {"const": "subject-index-structure-locator-review-v1"}, "artifact_path": {"$ref": "#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "review_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true},
    "provenanceArtifact": {"type": "object", "required": ["role", "schema_version", "artifact_path", "sha256"], "properties": {"role": {"type": "string"}, "schema_version": {"type": "string"}, "artifact_path": {"$ref": "#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "scoreView": {"type": "object", "required": ["view_id", "label", "view_kind", "score", "maximum", "calculation", "structure_locator_review", "causal_attribution", "provenance_artifacts"], "properties": {"view_id": {"type": "string"}, "label": {"type": "string"}, "view_kind": {"enum": ["observed", "counterfactual"]}, "score": {"type": ["number", "null"]}, "maximum": {"const": 100}, "calculation": {"$ref": "#/$defs/calculationReference"}, "structure_locator_review": {"$ref": "#/$defs/reviewReference"}, "causal_attribution": {"enum": ["primary_observed_result", "separate_evidentiary_correction_not_methodology_effect"]}, "provenance_artifacts": {"type": "array", "items": {"$ref": "#/$defs/provenanceArtifact"}}, "locator_fit_supplement": {"$ref": "v8-projection-metadata-v1.schema.json#/$defs/fitSupplementReference"}}, "additionalProperties": false},
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"}
  },
  "additionalProperties": false
}
