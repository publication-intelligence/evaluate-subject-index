{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V10 result, web, and score-view projection metadata with causal source binding",
  "type": "object",
  "required": [
    "gate_assessment",
    "schema_version",
    "candidate_label",
    "inclusion_policy",
    "uncertainty_policy",
    "critical_gates",
    "canonical_calculation",
    "canonical_structure_audit",
    "canonical_heading_access_source",
    "projection_metadata_sha256",
    "evaluation_validity"
  ],
  "properties": {
    "gate_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "indeterminate"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blocker_id": {
                "type": "string",
                "pattern": "^GATE-ASSESSMENT-"
              },
              "affected_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "semantic_unknown_axes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "treatment",
                    "complete_path_fit",
                    "keep",
                    "judgment_subtype",
                    "coverage",
                    "stance_preserved",
                    "realistic_first_lookup_success",
                    "architecture",
                    "result"
                  ]
                }
              },
              "dependent_reference_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "blocker_id",
              "affected_item_ids",
              "reason"
            ]
          }
        }
      },
      "required": [
        "status",
        "blockers"
      ]
    },
    "review_signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "valid",
            "indeterminate",
            "invalid"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocker_id": {
                    "const": "VALIDITY-UNINSPECTABLE"
                  },
                  "outcome": {
                    "const": "indeterminate"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rate": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "threshold": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "reason",
                  "blocker_id",
                  "outcome",
                  "count",
                  "denominator",
                  "rate",
                  "threshold"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocker_id": {
                    "const": "VALIDITY-SOURCE-SPAN"
                  },
                  "outcome": {
                    "const": "invalid"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "binding_role": {
                          "enum": [
                            "source_identity",
                            "source_span",
                            "page_map"
                          ]
                        },
                        "expected": {
                          "type": "string",
                          "minLength": 1
                        },
                        "observed": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true,
                          "minItems": 1
                        }
                      },
                      "required": [
                        "binding_role",
                        "expected",
                        "observed",
                        "evidence_ids"
                      ]
                    }
                  }
                },
                "required": [
                  "reason",
                  "blocker_id",
                  "outcome",
                  "evidence"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocker_id": {
                    "const": "VALIDITY-ATTESTATION"
                  },
                  "outcome": {
                    "const": "indeterminate"
                  }
                },
                "required": [
                  "reason",
                  "blocker_id",
                  "outcome"
                ]
              }
            ]
          }
        },
        "used_as_publication_gate": {
          "const": false
        }
      },
      "required": [
        "status",
        "blockers",
        "used_as_publication_gate"
      ]
    },
    "schema_version": {
      "const": "subject-index-v10-projection-metadata-v2"
    },
    "candidate_label": {
      "$ref": "#/$defs/inherited_1"
    },
    "inclusion_policy": {
      "$ref": "#/$defs/inherited_2"
    },
    "uncertainty_policy": {
      "$ref": "#/$defs/inherited_3"
    },
    "critical_gates": {
      "$ref": "#/$defs/inherited_4"
    },
    "report_id": {
      "$ref": "#/$defs/inherited_5"
    },
    "headline": {
      "$ref": "#/$defs/inherited_6"
    },
    "summary": {
      "$ref": "#/$defs/inherited_7"
    },
    "interpretation": {
      "$ref": "#/$defs/inherited_8"
    },
    "defect_counts": {
      "$ref": "#/$defs/inherited_9"
    },
    "strengths": {
      "$ref": "#/$defs/inherited_10"
    },
    "defects": {
      "$ref": "#/$defs/inherited_11"
    },
    "examples": {
      "$ref": "#/$defs/inherited_12"
    },
    "limitations": {
      "$ref": "#/$defs/inherited_13"
    },
    "canonical_calculation": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256",
        "calculation_sha256",
        "rubric_version",
        "calculation_profile",
        "execution_contract"
      ],
      "properties": {
        "schema_version": {
          "const": "subject-index-dimension-calculations-v9"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "calculation_sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "rubric_version": {
          "const": "subject-index-rubric-v10"
        },
        "calculation_profile": {
          "const": "subject-index-dimension-calculation-v9"
        },
        "execution_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_contract_id",
            "contract_constituents",
            "successor_runtime_commit",
            "runtime_payload_sha256",
            "compatibility_sha256",
            "source_release_file_sha256"
          ],
          "properties": {
            "execution_contract_id": {
              "const": "subject-index-v10-semantic-execution-v1"
            },
            "contract_constituents": {
              "const": {
                "subject-index-evaluation-v10-decision-v1": "f812eae0d09b60a4c1e74b1b6b9e6dd5850e088f9f9bb583152e9559f6ee07a9",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v1": "e0f0e91a23274a94e292409b17df53d1b403bd0a52b26e6e7ae84809430c5f76",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v2": "fea2a5b87f9e063d28135895fdb7d3637dfe4d2edd294fb7a50fd3aff7009277",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v3": "4031abef00cb37508f30c8c89ec5e12592ce89369f144c1473ebc43bf9503a7d",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v4": "b5d51033cb03093ca242841f8d9a5aac510915cfedad800614078e5199220a64"
              }
            },
            "successor_runtime_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "runtime_payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compatibility_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_release_file_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "canonical_structure_audit": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "structure-audit-v6"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "canonical_heading_access_source": {
      "allOf": [
        {
          "$ref": "#/$defs/inherited_16"
        },
        {
          "properties": {
            "role": {
              "const": "heading_access_causal_source"
            },
            "schema_version": {
              "const": "structure-audit-v6"
            }
          }
        }
      ]
    },
    "counterfactual_score_views": {
      "$ref": "#/$defs/inherited_17"
    },
    "projection_metadata_sha256": {
      "$ref": "#/$defs/inherited_20"
    }
  },
  "additionalProperties": false,
  "$id": "v10-projection-metadata-v2.schema.json",
  "$defs": {
    "inherited_1": {
      "type": "string",
      "minLength": 1
    },
    "inherited_2": {
      "type": "string",
      "minLength": 1
    },
    "inherited_3": {
      "type": "string",
      "minLength": 1
    },
    "inherited_4": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_5": {
      "type": "string"
    },
    "inherited_6": {
      "type": "string"
    },
    "inherited_7": {
      "type": "string"
    },
    "inherited_8": {
      "type": "string"
    },
    "inherited_9": {
      "type": "object"
    },
    "inherited_10": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_11": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_12": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_13": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inherited_14": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "inherited_15": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inherited_16": {
      "type": "object",
      "required": [
        "role",
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "inherited_18": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256",
        "calculation_sha256",
        "rubric_version",
        "calculation_profile",
        "execution_contract"
      ],
      "properties": {
        "schema_version": {
          "const": "subject-index-dimension-calculations-v9"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "calculation_sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "rubric_version": {
          "const": "subject-index-rubric-v10"
        },
        "calculation_profile": {
          "const": "subject-index-dimension-calculation-v9"
        },
        "execution_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_contract_id",
            "contract_constituents",
            "successor_runtime_commit",
            "runtime_payload_sha256",
            "compatibility_sha256",
            "source_release_file_sha256"
          ],
          "properties": {
            "execution_contract_id": {
              "const": "subject-index-v10-semantic-execution-v1"
            },
            "contract_constituents": {
              "const": {
                "subject-index-evaluation-v10-decision-v1": "f812eae0d09b60a4c1e74b1b6b9e6dd5850e088f9f9bb583152e9559f6ee07a9",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v1": "e0f0e91a23274a94e292409b17df53d1b403bd0a52b26e6e7ae84809430c5f76",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v2": "fea2a5b87f9e063d28135895fdb7d3637dfe4d2edd294fb7a50fd3aff7009277",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v3": "4031abef00cb37508f30c8c89ec5e12592ce89369f144c1473ebc43bf9503a7d",
                "subject-index-evaluation-v10-semantic-uncertainty-addendum-v4": "b5d51033cb03093ca242841f8d9a5aac510915cfedad800614078e5199220a64"
              }
            },
            "successor_runtime_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "runtime_payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compatibility_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_release_file_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "inherited_19": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "structure-audit-v5"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "inherited_17": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "view_id",
          "label",
          "calculation",
          "structure_audit",
          "provenance_artifacts"
        ],
        "properties": {
          "view_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "canonical_as_delivered"
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "calculation": {
            "$ref": "#/$defs/inherited_18"
          },
          "structure_audit": {
            "$ref": "#/$defs/inherited_19"
          },
          "provenance_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/inherited_16"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "inherited_20": {
      "$ref": "#/$defs/inherited_15"
    },
    "percentageOnly": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "pattern": "(^rating$|^rating_delta$|^maximum_rating$|_rating$)"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/percentageOnly"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/percentageOnly"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/percentageOnly"
    }
  ]
}
