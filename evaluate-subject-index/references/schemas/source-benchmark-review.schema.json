{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-benchmark-review.schema.json",
  "title": "Independent candidate-blind source benchmark review",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "review_mode", "candidate_blindness", "reviewer_independence", "draft", "coverage", "approved_changes", "remaining_issues", "completion", "recommendation"],
  "properties": {
    "schema_version": {"const": "source-benchmark-review-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "review_mode": {"enum": ["full", "pilot"]},
    "candidate_blindness": {"enum": ["preserved", "compromised", "not_claimed"]},
    "reviewer_independence": {
      "type": "object",
      "required": ["fresh_context", "candidate_unseen", "source_reconnected_sha256"],
      "properties": {
        "fresh_context": {"type": "boolean"},
        "candidate_unseen": {"type": "boolean"},
        "source_reconnected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "draft": {
      "type": "object",
      "required": ["version", "sha256", "candidate_blindness"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_blindness": {"const": "preserved"}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["subject_ids_reviewed", "relationship_ids_reviewed", "reader_task_ids_reviewed", "cross_chapter_subject_ids_reviewed", "unresolved_relationship_ids_dispositioned", "fallback_reader_task_ids_reviewed"],
      "properties": {
        "subject_ids_reviewed": {"type": "array", "items": {"type": "string", "pattern": "^SUBJ-"}, "uniqueItems": true},
        "relationship_ids_reviewed": {"type": "array", "items": {"type": "string", "pattern": "^REL-"}, "uniqueItems": true},
        "reader_task_ids_reviewed": {"type": "array", "items": {"type": "string", "pattern": "^TASK-"}, "uniqueItems": true},
        "cross_chapter_subject_ids_reviewed": {"type": "array", "items": {"type": "string", "pattern": "^SUBJ-"}, "uniqueItems": true},
        "unresolved_relationship_ids_dispositioned": {"type": "array", "items": {"type": "string", "pattern": "^REL-"}, "uniqueItems": true},
        "fallback_reader_task_ids_reviewed": {"type": "array", "items": {"type": "string", "pattern": "^TASK-"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "approved_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_type", "entity_id", "action"],
        "properties": {
          "entity_type": {"enum": ["benchmark", "subject", "relationship", "reader_task"]},
          "entity_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["add", "remove", "update"]},
          "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "remaining_issues": {"type": "array", "items": {"type": "object"}},
    "completion": {
      "type": "object",
      "required": ["structural_validation_passed", "editorial_review_complete", "source_first_omission_review_complete", "candidate_blindness_preserved", "no_unreviewed_required_items", "public_claims_allowed"],
      "properties": {
        "structural_validation_passed": {"type": "boolean"},
        "editorial_review_complete": {"type": "boolean"},
        "source_first_omission_review_complete": {"type": "boolean"},
        "candidate_blindness_preserved": {"type": "boolean"},
        "no_unreviewed_required_items": {"type": "boolean"},
        "public_claims_allowed": {"type": "boolean"}
      }
    },
    "recommendation": {"enum": ["retain_draft", "approve_revised", "revise_before_freeze", "blocked"]}
  },
  "additionalProperties": true
}
