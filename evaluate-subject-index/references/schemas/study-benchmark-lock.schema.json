{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-benchmark-lock.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "release",
    "benchmark_semantic_sha256",
    "source_scope",
    "policy_profile",
    "policy_semantic_sha256",
    "audit_mode",
    "rubric_version",
    "calculation_profile",
    "density_basis",
    "lock_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "ohfr-study-benchmark-lock-v1",
        "subject-index-study-benchmark-lock-v1"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "required": [
        "release_id",
        "benchmark_id",
        "version",
        "benchmark_sha256",
        "benchmark_file_sha256",
        "lineage"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "benchmark_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "benchmark_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_descriptor_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lineage": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "artifact_freeze_commit"
              ],
              "properties": {
                "kind": {
                  "const": "git_freeze"
                },
                "artifact_freeze_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "source_only_state_sha256",
                "draft_file_sha256",
                "review_file_sha256",
                "review_inventory_file_sha256",
                "checkpoint_artifacts"
              ],
              "properties": {
                "kind": {
                  "const": "native_source_freeze"
                },
                "source_only_state_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "draft_file_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "review_file_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "review_inventory_file_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checkpoint_artifacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "kind": {
                    "const": "git_freeze"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "release_descriptor_sha256"
            ]
          }
        }
      ]
    },
    "benchmark_semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Normalized source content; known release/editorial provenance is excluded by study_comparison.BENCHMARK_WRAPPERS and remains separately release-bound. Unknown top-level extensions remain fingerprinted."
    },
    "source_scope": {
      "type": "object",
      "required": [
        "source_sha256",
        "document_page_span",
        "page_map_sha256",
        "chunk_manifest_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document_page_span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "page_map_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunk_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "policy_profile": {
      "const": "subject-index-standard-policy-v8.2"
    },
    "policy_semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audit_mode": {
      "enum": [
        "full",
        "pilot"
      ]
    },
    "rubric_version": {
      "const": "subject-index-rubric-v8.2"
    },
    "calculation_profile": {
      "const": "subject-index-dimension-calculation-v7"
    },
    "density_basis": {
      "type": "object",
      "required": [
        "basis_id",
        "chunks",
        "measurement_sha256"
      ],
      "properties": {
        "basis_id": {
          "type": "string",
          "minLength": 1
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "chunk_id",
              "indexable_source_words",
              "source_artifact"
            ],
            "properties": {
              "chunk_id": {
                "type": "string",
                "minLength": 1
              },
              "indexable_source_words": {
                "type": "integer",
                "minimum": 0
              },
              "source_artifact": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "measurement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
