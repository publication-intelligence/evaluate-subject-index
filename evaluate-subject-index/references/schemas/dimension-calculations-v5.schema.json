{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dimension-calculations-v5.schema.json",
  "title": "Deterministic V8 subject-index dimension calculations",
  "type": "object",
  "required": ["schema_version", "calculation_id", "evaluation_id", "rubric_version", "calculation_profile", "audit_mode", "status", "evidence_identity", "input_artifacts", "diagnostic_item_grades", "publication_readiness_gates", "structure_audit", "dimensions", "total_score", "maximum_score", "arithmetic_check", "calculation_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-dimension-calculations-v5"},
    "calculation_id": {"type": "string", "pattern": "^CALC-[A-F0-9]{12}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "rubric_version": {"const": "subject-index-rubric-v8"},
    "calculation_profile": {"const": "subject-index-dimension-calculation-v4"},
    "audit_mode": {"enum": ["full", "pilot"]},
    "status": {"enum": ["scored", "not_scored_insufficient_evidence"]},
    "evidence_identity": {"$ref": "#/$defs/evidenceIdentity"},
    "input_artifacts": {"type": "array", "minItems": 3, "items": {"$ref": "calculation-components.schema.json#/$defs/inputArtifact"}, "uniqueItems": true},
    "diagnostic_item_grades": {
      "type": "object",
      "required": ["used_in_dimension_arithmetic", "policy", "required_policy_version", "expected_source_subjects"],
      "properties": {
        "used_in_dimension_arithmetic": {"const": false},
        "policy": {"const": "separate_non_additive_display_layer_independent_of_binary_rating_credit"},
        "required_policy_version": {"const": "subject-index-item-grading-v4"},
        "expected_source_subjects": {"type": "object", "required": ["count", "id_set_sha256"], "properties": {"count": {"type": "integer", "minimum": 0}, "id_set_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "publication_readiness_gates": {
      "type": "object",
      "required": ["used_in_score_arithmetic", "policy"],
      "properties": {"used_in_score_arithmetic": {"const": false}, "policy": {"const": "separate_claim_restrictions"}},
      "additionalProperties": false
    },
    "structure_audit": {"type": "object", "required": ["schema_version", "candidate_denominator", "full_scope_attestation", "locator_architecture", "uncertainties"], "properties": {"schema_version": {"const": "structure-audit-v5"}, "candidate_denominator": {"$ref": "structure-audit-v5.schema.json#/properties/candidate_denominator"}, "full_scope_attestation": {"$ref": "structure-audit-v5.schema.json#/properties/full_scope_attestation"}, "locator_architecture": {"$ref": "structure-audit-v5.schema.json#/properties/locator_architecture"}, "uncertainties": {"$ref": "structure-audit-v5.schema.json#/properties/uncertainties"}}, "additionalProperties": false},
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/dimension"},
      "allOf": [
        {"contains": {"properties": {"dimension_id": {"const": "meaningful_coverage"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "editorial_selectivity"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "conceptual_stance_fidelity"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "page_reference_reliability"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "findability_navigation"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "mechanics_consistency"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "total_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "maximum_score": {"const": 100},
    "arithmetic_check": {"type": "boolean"},
    "calculation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceIdentity": {
      "type": "object",
      "required": ["candidate_sha256", "source_sha256", "benchmark_sha256", "policy_sha256", "page_map_sha256", "chunk_manifest_sha256", "structure_audit_file_sha256", "locator_audit_set_sha256", "missing_access_audit_set_sha256"],
      "properties": {
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "page_map_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "structure_audit_file_sha256": {"$ref": "#/$defs/sha256"},
        "locator_audit_set_sha256": {"$ref": "#/$defs/sha256"},
        "missing_access_audit_set_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "uncertaintyTriple": {
      "type": "object",
      "required": ["lower", "central", "upper"],
      "properties": {"lower": {"$ref": "#/$defs/decimal"}, "central": {"$ref": "#/$defs/decimal"}, "upper": {"$ref": "#/$defs/decimal"}},
      "additionalProperties": false
    },
    "completeTierCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "judgmentCounts": {
      "type": "object",
      "required": ["supported", "partially_supported", "unsupported", "uninspectable", "not_measured"],
      "properties": {
        "supported": {"type": "integer", "minimum": 0},
        "partially_supported": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "uninspectable": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "treatmentTierCounts": {
      "type": "object",
      "required": ["substantive", "mixed", "weak_presence", "absent", "invalid_destination", "uninspectable", "not_measured"],
      "properties": {
        "substantive": {"type": "integer", "minimum": 0},
        "mixed": {"type": "integer", "minimum": 0},
        "weak_presence": {"type": "integer", "minimum": 0},
        "absent": {"type": "integer", "minimum": 0},
        "invalid_destination": {"type": "integer", "minimum": 0},
        "uninspectable": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "fitTierCounts": {
      "type": "object",
      "required": ["exact_fit", "material_partial_fit", "material_mismatch", "severe_mismatch", "no_fit", "uninspectable", "not_measured"],
      "properties": {
        "exact_fit": {"type": "integer", "minimum": 0},
        "material_partial_fit": {"type": "integer", "minimum": 0},
        "material_mismatch": {"type": "integer", "minimum": 0},
        "severe_mismatch": {"type": "integer", "minimum": 0},
        "no_fit": {"type": "integer", "minimum": 0},
        "uninspectable": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "diagnosticCreditCounts": {
      "type": "object",
      "required": ["1", "0.7", "0.35", "0.25", "0.15", "0", "uninspectable", "not_measured"],
      "properties": {
        "1": {"type": "integer", "minimum": 0},
        "0.7": {"type": "integer", "minimum": 0},
        "0.35": {"type": "integer", "minimum": 0},
        "0.25": {"type": "integer", "minimum": 0},
        "0.15": {"type": "integer", "minimum": 0},
        "0": {"type": "integer", "minimum": 0},
        "uninspectable": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ratingCreditCounts": {
      "type": "object",
      "required": ["1", "0", "uninspectable", "not_measured"],
      "properties": {
        "1": {"type": "integer", "minimum": 0},
        "0": {"type": "integer", "minimum": 0},
        "uninspectable": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "utilityAssignment": {
      "type": "object",
      "required": ["locator_id", "judgment", "treatment_class", "source_scope_status", "inspectability_state", "error_codes", "applicable_structured_defect_ids", "locator_severity", "treatment_category", "treatment_score", "fit_category", "fit_score", "treatment_rule_id", "fit_rule_id", "mapping_rule_id", "fit_classification_source", "diagnostic_credit", "diagnostic_grade", "rating_credit", "rating_rule_id", "disposition", "disposition_reason", "rating_credit_uncertainty_bounds"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-"},
        "judgment": {"enum": ["supported", "partially_supported", "unsupported", "uninspectable", "not_measured"]},
        "treatment_class": {"type": ["string", "null"]},
        "source_scope_status": {"type": ["string", "null"]},
        "inspectability_state": {"enum": ["inspectable", "known_excluded_nonindexable", "uninspectable_unavailable", "uninspectable_ambiguous", "not_measured"]},
        "error_codes": {"type": "array", "items": {"enum": ["SCP", "COV", "SEL", "CON", "STA", "LOC_POS", "LOC_NEG", "CMP", "HED", "SUB", "XRF", "DEN", "MEC"]}, "uniqueItems": true},
        "applicable_structured_defect_ids": {"type": "array", "items": {"type": "string", "pattern": "^DEFECT-"}, "uniqueItems": true},
        "locator_severity": {"enum": ["none", "cosmetic", "minor", "major", "critical", null]},
        "treatment_category": {"enum": ["substantive", "mixed", "weak_presence", "absent", "invalid_destination", "uninspectable", "not_measured"]},
        "treatment_score": {"enum": ["1", "0.7", "0.25", "0", null]},
        "fit_category": {"enum": ["exact_fit", "material_partial_fit", "material_mismatch", "severe_mismatch", "no_fit", "uninspectable", "not_measured"]},
        "fit_score": {"enum": ["1", "0.7", "0.35", "0.15", "0", null]},
        "treatment_rule_id": {"type": "string", "pattern": "^T-[A-Z0-9-]+$"},
        "fit_rule_id": {"type": "string", "pattern": "^F-[A-Z0-9-]+$"},
        "mapping_rule_id": {"type": "string", "pattern": "^T-[A-Z0-9-]+\\+F-[A-Z0-9-]+\\+MIN$"},
        "fit_classification_source": {"enum": ["native_complete_path_fit", "not_measured"]},
        "diagnostic_credit": {"enum": ["1", "0.7", "0.35", "0.25", "0.15", "0", null]},
        "diagnostic_grade": {"enum": [100, 70, 35, 25, 15, 0, null]},
        "rating_credit": {"enum": ["1", "0", null]},
        "rating_rule_id": {"type": "string", "pattern": "^R-[A-Z0-9-]+$"},
        "disposition": {"enum": ["assessable", "bounded", "not_measured"]},
        "disposition_reason": {"type": "string", "minLength": 1},
        "rating_credit_uncertainty_bounds": {"type": "object", "required": ["lower", "upper"], "properties": {"lower": {"$ref": "#/$defs/decimal"}, "upper": {"$ref": "#/$defs/decimal"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "reliabilityProvenance": {
      "type": "object",
      "required": ["model", "original_locator_denominator", "assessable_locator_denominator", "uninspectable_locator_count", "not_measured_locator_count", "counts_by_judgment", "counts_by_treatment_class", "counts_by_treatment_tier", "counts_by_fit_tier", "counts_by_diagnostic_credit_value", "counts_by_rating_credit_value", "locator_utility_assignments", "mapping_rejections", "treatment_score_numerator", "treatment_score_denominator", "mean_treatment_score", "fit_score_numerator", "fit_score_denominator", "mean_fit_score", "diagnostic_credit_numerator", "diagnostic_credit_denominator", "mean_diagnostic_credit", "keep_precision_numerator", "keep_precision_denominator", "keep_precision", "treatment_recall_numerator", "treatment_recall_denominator", "treatment_recall", "reliability_f1", "treatment_score_uncertainty", "fit_score_uncertainty", "diagnostic_credit_uncertainty", "keep_precision_uncertainty", "treatment_recall_uncertainty", "rating_credit_source", "diagnostic_grade_formula", "diagnostic_grades_used_in_dimension_arithmetic", "pre_cap_rating", "cap_evaluations", "applied_cap", "uncertainty_lower", "uncertainty_upper", "rounding", "final_rating", "dimension_weight", "awarded_points"],
      "properties": {
        "model": {"const": "binary_keep_precision_with_two_axis_diagnostics_v1"},
        "original_locator_denominator": {"type": "integer", "minimum": 0},
        "assessable_locator_denominator": {"type": "integer", "minimum": 0},
        "uninspectable_locator_count": {"type": "integer", "minimum": 0},
        "not_measured_locator_count": {"type": "integer", "minimum": 0},
        "counts_by_judgment": {"$ref": "#/$defs/judgmentCounts"},
        "counts_by_treatment_class": {"$ref": "#/$defs/completeTierCounts"},
        "counts_by_treatment_tier": {"$ref": "#/$defs/treatmentTierCounts"},
        "counts_by_fit_tier": {"$ref": "#/$defs/fitTierCounts"},
        "counts_by_diagnostic_credit_value": {"$ref": "#/$defs/diagnosticCreditCounts"},
        "counts_by_rating_credit_value": {"$ref": "#/$defs/ratingCreditCounts"},
        "locator_utility_assignments": {"type": "array", "items": {"$ref": "#/$defs/utilityAssignment"}},
        "mapping_rejections": {"type": "array", "maxItems": 0},
        "treatment_score_numerator": {"$ref": "#/$defs/decimal"},
        "treatment_score_denominator": {"type": "integer", "minimum": 0},
        "mean_treatment_score": {"$ref": "#/$defs/decimal"},
        "fit_score_numerator": {"$ref": "#/$defs/decimal"},
        "fit_score_denominator": {"type": "integer", "minimum": 0},
        "mean_fit_score": {"$ref": "#/$defs/decimal"},
        "diagnostic_credit_numerator": {"$ref": "#/$defs/decimal"},
        "diagnostic_credit_denominator": {"type": "integer", "minimum": 0},
        "mean_diagnostic_credit": {"$ref": "#/$defs/decimal"},
        "keep_precision_numerator": {"type": "integer", "minimum": 0},
        "keep_precision_denominator": {"type": "integer", "minimum": 0},
        "keep_precision": {"$ref": "#/$defs/decimal"},
        "treatment_recall_numerator": {"type": "integer", "minimum": 0},
        "treatment_recall_denominator": {"type": "integer", "minimum": 0},
        "treatment_recall": {"$ref": "#/$defs/decimal"},
        "reliability_f1": {"$ref": "#/$defs/decimal"},
        "treatment_score_uncertainty": {"$ref": "#/$defs/uncertaintyTriple"},
        "fit_score_uncertainty": {"$ref": "#/$defs/uncertaintyTriple"},
        "diagnostic_credit_uncertainty": {"$ref": "#/$defs/uncertaintyTriple"},
        "keep_precision_uncertainty": {"$ref": "#/$defs/uncertaintyTriple"},
        "treatment_recall_uncertainty": {"$ref": "#/$defs/uncertaintyTriple"},
        "rating_credit_source": {"const": "locator_utility_assignments[].rating_credit"},
        "diagnostic_grade_formula": {"const": "100 * diagnostic_credit"},
        "diagnostic_grades_used_in_dimension_arithmetic": {"const": false},
        "pre_cap_rating": {"$ref": "calculation-components.schema.json#/$defs/decimal"},
        "cap_evaluations": {"type": "array", "items": {"$ref": "calculation-components.schema.json#/$defs/cap"}},
        "applied_cap": {"$ref": "calculation-components.schema.json#/$defs/appliedCap"},
        "uncertainty_lower": {"$ref": "calculation-components.schema.json#/$defs/bound"},
        "uncertainty_upper": {"$ref": "calculation-components.schema.json#/$defs/bound"},
        "rounding": {"type": "object"},
        "final_rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "dimension_weight": {"const": 25},
        "awarded_points": {"type": ["number", "null"], "minimum": 0, "maximum": 25}
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["dimension_id", "status", "formula_id", "input_roles", "input_artifacts", "denominators", "raw_status_counts", "credit_mappings", "components", "base_rating", "unrounded_rating", "cap_evaluations", "applied_cap", "pre_cap_rating", "post_cap_rating", "missing_data_bounds", "rounding", "final_rating", "dimension_weight", "awarded_points", "warnings"],
      "properties": {
        "dimension_id": {"enum": ["meaningful_coverage", "editorial_selectivity", "conceptual_stance_fidelity", "page_reference_reliability", "findability_navigation", "mechanics_consistency"]},
        "status": {"enum": ["scored", "not_scored_incomplete_full_audit", "not_scored_insufficient_evidence"]},
        "formula_id": {"type": "string", "pattern": "^subject-index-dimension-calculation-v4:"},
        "input_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "calculation-components.schema.json#/$defs/inputArtifact"}, "uniqueItems": true},
        "denominators": {"type": "object", "required": ["components"], "properties": {"components": {"type": "array", "minItems": 1, "items": {"$ref": "calculation-components.schema.json#/$defs/denominator"}}}, "additionalProperties": false},
        "raw_status_counts": {"type": "object"},
        "credit_mappings": {"type": "object"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "calculation-components.schema.json#/$defs/component"}},
        "base_rating": {"$ref": "calculation-components.schema.json#/$defs/decimal"},
        "unrounded_rating": {"$ref": "calculation-components.schema.json#/$defs/decimal"},
        "cap_evaluations": {"type": "array", "minItems": 1, "items": {"$ref": "calculation-components.schema.json#/$defs/cap"}},
        "applied_cap": {"$ref": "calculation-components.schema.json#/$defs/appliedCap"},
        "pre_cap_rating": {"$ref": "calculation-components.schema.json#/$defs/decimal"},
        "post_cap_rating": {"$ref": "calculation-components.schema.json#/$defs/decimal"},
        "missing_data_bounds": {"type": "object", "required": ["lower", "upper", "stable_rating", "stable_cap_outcome"], "properties": {"lower": {"$ref": "calculation-components.schema.json#/$defs/bound"}, "upper": {"$ref": "calculation-components.schema.json#/$defs/bound"}, "stable_rating": {"type": "boolean"}, "stable_cap_outcome": {"type": "boolean"}}, "additionalProperties": false},
        "rounding": {"type": "object"},
        "final_rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "dimension_weight": {"enum": [5, 15, 20, 25]},
        "awarded_points": {"type": ["number", "null"], "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "reliability_provenance": {"$ref": "#/$defs/reliabilityProvenance"}
      },
      "allOf": [{"if": {"properties": {"dimension_id": {"const": "page_reference_reliability"}}, "required": ["dimension_id"]}, "then": {"required": ["reliability_provenance"]}, "else": {"not": {"required": ["reliability_provenance"]}}}],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
