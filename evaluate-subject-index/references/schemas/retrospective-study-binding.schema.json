{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrospective-study-binding.schema.json",
  "type": "object",
  "required": [
    "candidate_seen",
    "migrated_at",
    "semantic_change",
    "policy_semantic_change",
    "audit_transfer_authorized",
    "historical_freeze",
    "prior_state",
    "lock",
