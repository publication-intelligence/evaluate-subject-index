{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V9 result, web, and score-view projection metadata with causal source binding",
  "type": "object",
  "required": [
    "gate_assessment",
    "schema_version",
    "candidate_label",
    "inclusion_policy",
    "uncertainty_policy",
    "critical_gates",
    "canonical_calculation",
    "canonical_structure_audit",
    "canonical_heading_access_source",
    "projection_metadata_sha256"
  ],
  "properties": {
    "gate_assessment": {
      "type": "object",
      "required": [
        "status",
        "blockers"
      ],
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "indeterminate"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "blocker_id",
              "affected_item_ids",
              "reason"
            ],
            "properties": {
              "blocker_id": {
                "type": "string"
              },
              "affected_item_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "review_signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_validity": {
      "type": "object"
    },
    "schema_version": {
      "const": "subject-index-v9-projection-metadata-v1"
    },
    "candidate_label": {
      "$ref": "#/$defs/inherited_1"
    },
    "inclusion_policy": {
      "$ref": "#/$defs/inherited_2"
    },
    "uncertainty_policy": {
      "$ref": "#/$defs/inherited_3"
    },
    "critical_gates": {
      "$ref": "#/$defs/inherited_4"
    },
    "report_id": {
      "$ref": "#/$defs/inherited_5"
    },
    "headline": {
      "$ref": "#/$defs/inherited_6"
    },
    "summary": {
      "$ref": "#/$defs/inherited_7"
    },
    "interpretation": {
      "$ref": "#/$defs/inherited_8"
    },
    "defect_counts": {
      "$ref": "#/$defs/inherited_9"
    },
    "strengths": {
      "$ref": "#/$defs/inherited_10"
    },
    "defects": {
      "$ref": "#/$defs/inherited_11"
    },
    "examples": {
      "$ref": "#/$defs/inherited_12"
    },
    "limitations": {
      "$ref": "#/$defs/inherited_13"
    },
    "canonical_calculation": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256",
        "calculation_sha256",
        "rubric_version",
        "calculation_profile"
      ],
      "properties": {
        "schema_version": {
          "const": "subject-index-dimension-calculations-v7"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "calculation_sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "rubric_version": {
          "const": "subject-index-rubric-v9"
        },
        "calculation_profile": {
          "const": "subject-index-dimension-calculation-v8"
        }
      },
      "additionalProperties": false
    },
    "canonical_structure_audit": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "structure-audit-v6"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "canonical_heading_access_source": {
      "allOf": [
        {
          "$ref": "#/$defs/inherited_16"
        },
        {
          "properties": {
            "role": {
              "const": "heading_access_causal_source"
            },
            "schema_version": {
              "const": "structure-audit-v6"
            }
          }
        }
      ]
    },
    "counterfactual_score_views": {
      "$ref": "#/$defs/inherited_17"
    },
    "projection_metadata_sha256": {
      "$ref": "#/$defs/inherited_20"
    }
  },
  "additionalProperties": false,
  "$id": "v9-projection-metadata-v1.schema.json",
  "$defs": {
    "inherited_1": {
      "type": "string",
      "minLength": 1
    },
    "inherited_2": {
      "type": "string",
      "minLength": 1
    },
    "inherited_3": {
      "type": "string",
      "minLength": 1
    },
    "inherited_4": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_5": {
      "type": "string"
    },
    "inherited_6": {
      "type": "string"
    },
    "inherited_7": {
      "type": "string"
    },
    "inherited_8": {
      "type": "string"
    },
    "inherited_9": {
      "type": "object"
    },
    "inherited_10": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_11": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_12": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inherited_13": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inherited_14": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "inherited_15": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inherited_16": {
      "type": "object",
      "required": [
        "role",
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "inherited_18": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256",
        "calculation_sha256",
        "rubric_version",
        "calculation_profile"
      ],
      "properties": {
        "schema_version": {
          "const": "subject-index-dimension-calculations-v7"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "calculation_sha256": {
          "$ref": "#/$defs/inherited_15"
        },
        "rubric_version": {
          "const": "subject-index-rubric-v9"
        },
        "calculation_profile": {
          "const": "subject-index-dimension-calculation-v8"
        }
      },
      "additionalProperties": false
    },
    "inherited_19": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "structure-audit-v5"
        },
        "artifact_path": {
          "$ref": "#/$defs/inherited_14"
        },
        "sha256": {
          "$ref": "#/$defs/inherited_15"
        }
      },
      "additionalProperties": false
    },
    "inherited_17": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "view_id",
          "label",
          "calculation",
          "structure_audit",
          "provenance_artifacts"
        ],
        "properties": {
          "view_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "canonical_as_delivered"
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "calculation": {
            "$ref": "#/$defs/inherited_18"
          },
          "structure_audit": {
            "$ref": "#/$defs/inherited_19"
          },
          "provenance_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/inherited_16"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "inherited_20": {
      "$ref": "#/$defs/inherited_15"
    },
    "percentageOnly": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "pattern": "(^rating$|^rating_delta$|^maximum_rating$|_rating$)"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/percentageOnly"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/percentageOnly"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/percentageOnly"
    }
  ]
}
