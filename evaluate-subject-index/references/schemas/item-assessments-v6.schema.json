{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item-assessments-v6.schema.json",
  "title": "V8 diagnostic item assessments with binary keep credit",
  "type": "object",
  "required": ["schema_version", "grading_policy", "evaluation_id", "candidate_id", "candidate_sha256", "item_inventory_sha256", "item_inventory_artifact", "evidence_identity", "assessment_completeness", "audit_mode", "scope_complete", "grade_disclosure", "explanation_contract", "locator_grading_provenance", "structure_audit_binding", "color_legend", "locator_assessments", "path_assessments", "heading_node_assessments", "cross_reference_assessments", "source_subject_assessments", "summary"],
  "properties": {
    "schema_version": {"const": "subject-index-item-assessments-v6"},
    "grading_policy": {"const": "subject-index-item-grading-v4"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "item_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "item_inventory_artifact": {"type": "object", "required": ["schema_version", "artifact_path", "sha256"], "properties": {"schema_version": {"const": "subject-index-item-inventory-v2"}, "artifact_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "evidence_identity": {"$ref": "dimension-calculations-v5.schema.json#/$defs/evidenceIdentity"},
    "assessment_completeness": {"type": "object", "required": ["locators", "paths", "heading_nodes", "cross_references", "source_subjects"], "properties": {"locators": {"$ref": "#/$defs/completeness"}, "paths": {"$ref": "#/$defs/completeness"}, "heading_nodes": {"$ref": "#/$defs/completeness"}, "cross_references": {"$ref": "#/$defs/completeness"}, "source_subjects": {"$ref": "#/$defs/completeness"}}, "additionalProperties": false},
    "audit_mode": {"enum": ["full", "pilot"]},
    "scope_complete": {"type": "boolean"},
    "grade_disclosure": {"type": "string", "minLength": 1},
    "explanation_contract": {
      "type": "object",
      "required": ["contract_version", "authored_evidence_is_primary", "prose_used_in_scoring"],
      "properties": {
        "contract_version": {"const": "locator-explanations-v2"},
        "authored_evidence_is_primary": {"const": true},
        "prose_used_in_scoring": {"const": false}
      },
      "additionalProperties": false
    },
    "locator_grading_provenance": {
      "type": "object",
      "required": ["model", "page_treatment_mapping", "complete_path_fit_mapping", "diagnostic_combination_rule", "diagnostic_grade_rule", "rating_credit_rule", "calculation_locator_utility_ledger_sha256", "diagnostic_grades_used_in_dimension_arithmetic", "selectivity_mapping_unchanged", "weak_presence_selectivity_credit", "counts_by_treatment_tier", "counts_by_fit_tier", "counts_by_diagnostic_credit_value", "counts_by_rating_credit_value"],
      "properties": {
        "model": {"const": "two_axis_diagnostic_minimum_with_binary_keep_credit_v1"},
        "page_treatment_mapping": {"type": "object"},
        "complete_path_fit_mapping": {"type": "object"},
        "diagnostic_combination_rule": {"const": "min(page_treatment_score, complete_path_fit_score)"},
        "diagnostic_grade_rule": {"const": "100 * diagnostic_credit"},
        "rating_credit_rule": {"const": "supported=1; partially_supported=0; unsupported=0; uninspectable/not_measured=null"},
        "calculation_locator_utility_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "diagnostic_grades_used_in_dimension_arithmetic": {"const": false},
        "selectivity_mapping_unchanged": {"const": true},
        "weak_presence_selectivity_credit": {"const": 0},
        "counts_by_treatment_tier": {"$ref": "dimension-calculations-v5.schema.json#/$defs/treatmentTierCounts"},
        "counts_by_fit_tier": {"$ref": "dimension-calculations-v5.schema.json#/$defs/fitTierCounts"},
        "counts_by_diagnostic_credit_value": {"$ref": "dimension-calculations-v5.schema.json#/$defs/diagnosticCreditCounts"},
        "counts_by_rating_credit_value": {"$ref": "dimension-calculations-v5.schema.json#/$defs/ratingCreditCounts"}
      },
      "additionalProperties": false
    },
    "structure_audit_binding": {
      "type": "object",
      "required": ["schema_version", "candidate_sha256", "node_id_set_sha256", "cross_reference_id_set_sha256", "locator_bearing_path_id_set_sha256"],
      "properties": {
        "schema_version": {"const": "structure-audit-v5"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "node_id_set_sha256": {"$ref": "#/$defs/sha256"},
        "cross_reference_id_set_sha256": {"$ref": "#/$defs/sha256"},
        "locator_bearing_path_id_set_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "color_legend": {"$ref": "item-assessments.schema.json#/properties/color_legend"},
    "locator_assessments": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "item-assessments.schema.json#/$defs/assessedItem"},
          {
            "type": "object",
            "required": ["locator_id", "path_id", "dimension_reliability_credit", "locator_utility", "locator_explanation"],
            "properties": {
              "locator_id": {"type": "string", "pattern": "^LOC-"},
              "path_id": {"type": "string", "pattern": "^PATH-"},
              "dimension_reliability_credit": {"enum": ["1", "0", null]},
              "locator_utility": {"$ref": "dimension-calculations-v5.schema.json#/$defs/utilityAssignment"},
              "locator_explanation": {"$ref": "#/$defs/locatorExplanation"}
            }
          }
        ]
      }
    },
    "path_assessments": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "item-assessments.schema.json#/$defs/assessedItem"},
          {
            "type": "object",
            "required": ["path_id", "locator_ids"],
            "properties": {
              "path_id": {"type": "string", "pattern": "^PATH-"},
              "locator_ids": {"type": "array", "items": {"type": "string", "pattern": "^LOC-"}, "uniqueItems": true},
              "locator_architecture_review": {"type": "object"}
            }
          }
        ]
      }
    },
    "heading_node_assessments": {"$ref": "item-assessments.schema.json#/properties/heading_node_assessments"},
    "cross_reference_assessments": {"$ref": "item-assessments.schema.json#/properties/cross_reference_assessments"},
    "source_subject_assessments": {"$ref": "item-assessments.schema.json#/properties/source_subject_assessments"},
    "summary": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completeness": {"type": "object", "required": ["expected", "assessed", "unique", "complete", "id_set_sha256"], "properties": {"expected": {"type": "integer", "minimum": 0}, "assessed": {"type": "integer", "minimum": 0}, "unique": {"const": true}, "complete": {"type": "boolean"}, "id_set_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "axisExplanation": {
      "type": "object",
      "required": ["category", "score", "rule_id", "rationale", "rationale_source"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "rule_id": {"type": "string", "minLength": 1},
        "rationale": {"type": ["string", "null"], "minLength": 1},
        "rationale_source": {"enum": ["authored_evidence_summary", "authored_locator_audit", "mechanical_structured_category_rule"]}
      },
      "additionalProperties": false
    },
    "locatorExplanation": {
      "type": "object",
      "required": ["locator_id", "path_id", "evidence_summary", "page_treatment", "complete_path_fit", "diagnostic_locator_grade", "keep_rating_credit", "evidence_ids", "structured_defect_ids", "fit_rationale_required"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-"},
        "path_id": {"type": "string", "pattern": "^PATH-"},
        "evidence_summary": {"type": "string", "minLength": 1},
        "page_treatment": {"$ref": "#/$defs/axisExplanation"},
        "complete_path_fit": {"$ref": "#/$defs/axisExplanation"},
        "diagnostic_locator_grade": {
          "type": "object",
          "required": ["rule_id", "calculation", "score", "credit"],
          "properties": {
            "rule_id": {"type": "string", "minLength": 1},
            "calculation": {"type": "string", "minLength": 1},
            "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "credit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "keep_rating_credit": {
          "type": "object",
          "required": ["keep_decision", "rule_id", "credit"],
          "properties": {
            "keep_decision": {"type": "boolean"},
            "rule_id": {"type": "string", "pattern": "^R-[A-Z0-9-]+$"},
            "credit": {"enum": ["1", "0", null]}
          },
          "additionalProperties": false
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "structured_defect_ids": {"type": "array", "items": {"type": "string", "pattern": "^DEFECT-"}, "uniqueItems": true},
        "fit_rationale_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
